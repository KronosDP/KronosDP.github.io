---
// Click-to-zoom for site thumbnails/photos. Add a selector to ZOOMABLE_SELECTOR
// (kept in sync with the script below) to make a new image class zoomable.
---

<div id="lightbox" class="lightbox" aria-hidden="true">
  <button type="button" class="lightbox__close" id="lightbox-close" aria-label="Close image">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
  <img id="lightbox-image" class="lightbox__image" src="" alt="" />
</div>

<style is:global>
  .project-card__figure img,
  .talk-card__figure img,
  .featured-tool__screenshot,
  .identity-card__avatar,
  .article__prose img,
  .case-study__figure img {
    cursor: zoom-in;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  /* Zoom is only applied where a container clips the overflow, so the
     scaled image can't spill into neighboring content. */
  .project-card:hover .project-card__figure img,
  .talk-card:hover .talk-card__figure--image img,
  .featured-tool:hover .featured-tool__screenshot,
  .case-study__figure--image:hover img {
    transform: scale(1.045);
  }
</style>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 56px 24px;
    background: rgba(6, 9, 18, 0.92);
    backdrop-filter: blur(2px);
    cursor: zoom-out;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--duration-base) var(--ease-out),
      visibility 0s linear var(--duration-base);
  }
  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity var(--duration-base) var(--ease-out),
      visibility 0s linear 0s;
  }
  .lightbox__image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5);
    cursor: default;
    transform: scale(0.96);
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .lightbox.is-open .lightbox__image {
    transform: scale(1);
  }
  .lightbox__close {
    position: fixed;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-raised);
    color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      border-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }
  .lightbox__close:hover {
    border-color: var(--color-border-emphasis);
    color: var(--color-accent);
    transform: rotate(90deg);
  }
</style>

<script>
  const ZOOMABLE_SELECTOR =
    '.project-card__figure img, .talk-card__figure img, .featured-tool__screenshot, .identity-card__avatar, .article__prose img, .case-study__figure img';

  const overlay = document.getElementById('lightbox') as HTMLDivElement | null;
  const overlayImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
  const closeButton = document.getElementById('lightbox-close');

  function openLightbox(source: string, alt: string) {
    if (!overlay || !overlayImage) return;
    overlayImage.src = source;
    overlayImage.alt = alt;
    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!overlay || !overlayImage) return;
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const image = target.closest(ZOOMABLE_SELECTOR) as HTMLImageElement | null;
    if (image) {
      event.preventDefault();
      event.stopPropagation();
      openLightbox(image.currentSrc || image.src, image.alt);
      return;
    }
    if (overlay?.classList.contains('is-open') && target === overlay) {
      closeLightbox();
    }
  });

  closeButton?.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeLightbox();
  });
</script>
