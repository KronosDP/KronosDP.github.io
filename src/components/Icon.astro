---
// Small inline-SVG icon set, stroke-based on a 24px grid, replacing the
// Font Awesome 6 dependency (CDN in the design, self-hosted 168KB SCSS on
// the old site) for the ~16 glyphs the design actually uses.
interface Props {
  name:
    | 'download'
    | 'github'
    | 'linkedin'
    | 'instagram'
    | 'mail'
    | 'graduation-cap'
    | 'map-pin'
    | 'dot'
    | 'brain'
    | 'mic'
    | 'server'
    | 'file-pdf'
    | 'globe'
    | 'clock'
    | 'language'
    | 'arrow-right'
    | 'chevron-down'
    | 'menu'
    | 'close'
    | 'copy'
    | 'external';
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
---

{
  name === 'download' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M12 3v12" /><path d="M7 11l5 5 5-5" /><path d="M4 20h16" />
