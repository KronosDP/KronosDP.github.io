---
const clusters = [
  { id: '01', name: 'train', x: 26, y: 58, load: '76%', delay: '0s' },
  { id: '02', name: 'evaluate', x: 184, y: 34, load: '58%', delay: '-.8s' },
  { id: '03', name: 'serve', x: 342, y: 58, load: '89%', delay: '-1.6s' },
];
---
<div class="cluster-scene" aria-label="Illustration of three connected GPU clusters">
  <div class="cluster-heading"><span><span class="heading-slash">/</span> compute fabric</span><span class="cluster-state"><i></i> online</span></div>
  <svg class="cluster-diagram" viewBox="0 0 480 290" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id="cluster-front" x1="0" y1="0" x2="1" y2="1"><stop stop-color="var(--color-raised)"/><stop offset="1" stop-color="var(--color-canvas)"/></linearGradient>
      <radialGradient id="cluster-halo"><stop stop-color="var(--color-accent)" stop-opacity=".09"/><stop offset="1" stop-color="var(--color-accent)" stop-opacity="0"/></radialGradient>
    </defs>
    <ellipse cx="240" cy="154" rx="230" ry="130" fill="url(#cluster-halo)"/>
    <g class="floor-grid" stroke="var(--color-border)" stroke-width=".65">
      <path d="M8 213 238 109 472 213 240 280Z M49 230l230-105M98 245l229-99M147 260l229-94M426 230 197 126M378 245 151 147M331 260 104 168"/>
    </g>
    <g stroke="var(--color-accent)" stroke-width="1.2">
      <path class="connection-base" d="M82 204v27l130 29M240 180v68M398 204v27l-130 29"/>
      <path class="cluster-packets" d="M82 204v27l130 29M240 180v68M398 204v27l-130 29"/>
    </g>
    {clusters.map((cluster, index) => (
      <g transform={`translate(${cluster.x} ${cluster.y})`} class="cluster-rack" style={`--cluster-delay: ${cluster.delay}`}>
        <path d="M4 24 32 8l82 16-28 18Z" fill="var(--color-raised)" stroke="var(--color-accent)" stroke-opacity=".75"/>
        <path d="M86 42l28-18v126l-28 17Z" fill="var(--color-canvas)" stroke="var(--color-accent)" stroke-opacity=".65"/>
        <path d="M4 24l82 18v125L4 149Z" fill="url(#cluster-front)" stroke="var(--color-accent)"/>
        <path d="m18 24 66 14m-52-21 66 14" stroke="var(--color-accent)" stroke-opacity=".25"/>
        {[0, 1, 2, 3].map((bay) => (
          <g transform={`translate(0 ${bay * 25})`}>
            <path d="m12 39 66 14v18L12 57Z" fill="var(--color-page)" stroke="var(--color-border-emphasis)" stroke-width=".7"/>
            <path d="m18 46 37 8m-37-4 37 8" stroke="var(--color-muted)" stroke-opacity=".35" stroke-width=".7"/>
            <circle class="cluster-led" cx="69" cy="59" r="1.7" style={`animation-delay: ${index * -.6 - bay * .35}s`}/>
          </g>
        ))}
        <path d="m93 58 14-8m-14 15 14-8m-14 15 14-8m-14 42 14-8m-14 15 14-8m-14 15 14-8" stroke="var(--color-border-emphasis)" stroke-width=".8"/>
        <path d="m15 142 23 5" stroke="var(--color-accent)" stroke-opacity=".6"/>
      </g>
    ))}
    <g stroke="var(--color-accent)" stroke-width=".8">
      <path d="m212 252 27-10 29 10-28 11Z" fill="var(--color-raised)"/>
      <path d="M212 252v8l28 11 28-11v-8l-28 11Z" fill="var(--color-canvas)"/>
      <path d="m224 256 4 1m5 2 4 1m6-1 4-1m5-2 4-1" stroke="var(--color-success)"/>
    </g>
    <g fill="var(--color-muted)" font-family="monospace" font-size="9" letter-spacing="1.5" text-anchor="middle">
      <text x="82" y="47">CLUSTER 01</text><text x="240" y="23">CLUSTER 02</text><text x="398" y="47">CLUSTER 03</text>
    </g>
  </svg>
  <div class="cluster-stats" aria-hidden="true">
    {clusters.map(cluster => (
      <div class="cluster-stat" style={`--load: ${cluster.load}; --cluster-delay: ${cluster.delay}`}>
        <div><span class="cluster-id">{cluster.id}</span><span>{cluster.name}</span></div>
        <span class="cluster-meter"><i></i></span>
        <span class="cluster-detail">4 × GPU</span>
      </div>
    ))}
  </div>
  <div class="cluster-caption"><span>CUDA <span class="caption-divider">/</span> distributed compute</span><span>simulation</span></div>
</div>
<style>
  .cluster-scene { min-width: 0; width: 100%; color: var(--color-accent); font-family: var(--font-mono); }
  .cluster-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--color-badge-text); font-size: 10px; letter-spacing: .05em; }
  .heading-slash { color: var(--color-accent); margin-right: 6px; }
  .cluster-state { display: inline-flex; align-items: center; gap: 7px; color: var(--color-success); font-size: 9px; }
  .cluster-state i { width: 4px; height: 4px; border-radius: 50%; background: currentColor; box-shadow: 0 0 9px color-mix(in srgb, var(--color-success) 35%, transparent); }
  .cluster-diagram { display: block; width: 100%; height: auto; margin: 20px 0 12px; overflow: visible; }
  .floor-grid { opacity: .4; }
  .connection-base { opacity: .22; }
  .cluster-packets { stroke-dasharray: 3 15; animation: packet-flow 3s linear infinite; }
  .cluster-led { fill: var(--color-success); animation: cluster-activity 2.8s ease-in-out infinite; }
  .cluster-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 17px; }
  .cluster-stat > div { display: flex; gap: 7px; align-items: center; font-size: 10px; color: var(--color-badge-text); }
  .cluster-id { font-size: 8px; color: var(--color-muted); }
  .cluster-meter { display: block; height: 3px; margin: 9px 0 6px; background: var(--color-raised); }
  .cluster-meter i { display: block; width: var(--load); height: 100%; background: var(--color-accent); transform-origin: left; animation: cluster-load 4s ease-in-out infinite; animation-delay: var(--cluster-delay); }
  .cluster-detail { display: block; font-size: 8px; color: var(--color-muted); letter-spacing: .08em; }
  .cluster-caption { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px 12px; border-top: 1px solid var(--color-border); padding-top: 11px; margin-top: 15px; font-size: 8px; color: var(--color-muted); }
  .caption-divider { margin: 0 4px; color: var(--color-border-emphasis); }
  :global(.terminal-intro[data-paused]) .cluster-scene * { animation-play-state: paused !important; }
  @keyframes packet-flow { to { stroke-dashoffset: -72; } }
  @keyframes cluster-activity { 50% { opacity: .25; } }
  @keyframes cluster-load { 50% { transform: scaleX(.6); } }
  @media (max-width: 700px) { .cluster-diagram { max-width: 460px; margin: 20px auto 12px; } }
  @media (min-width: 701px) and (max-height: 850px) { .cluster-diagram { max-height: 210px; margin-top: 12px; margin-bottom: 8px; } }
  @media (prefers-reduced-motion: reduce) { .cluster-scene * { animation: none !important; } }
</style>
