---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const research = (await getCollection('research'))[0];
---

<BaseLayout title="Contact" description="Get in touch about AI research, ML engineering or data science roles.">
  <section class="container contact">
    <div class="dot-grid" style="right: 60px; top: 30px;"></div>
    <div class="contact__main" data-reveal>
      <span class="eyebrow">// contact</span>
      <h1 class="contact__title">Tell me what you’re building</h1>
      <p class="contact__lede">I reply to everything within a day. If it helps, say which of these it is: a role, a research collaboration, or a question about something on this site.</p>

      <div class="contact-methods">
        <button class="card card--emphasis contact-method" id="copy-email-btn" data-email="darrel.danadyaksa19@gmail.com" type="button">
          <span class="contact-method__icon"><Icon name="mail" size={16} /></span>
          <span class="contact-method__text">
            <span class="contact-method__title">darrel.danadyaksa19@gmail.com</span>
            <span class="contact-method__sub">Best for roles and anything with detail attached</span>
          </span>
          <span class="contact-method__action" id="copy-email-label">copy</span>
        </button>

        <a href="https://www.linkedin.com/in/darrel-danadyaksa-poli/" target="_blank" rel="noopener noreferrer" class="card contact-method" data-analytics="linkedin_click">
          <span class="contact-method__icon"><Icon name="linkedin" size={16} /></span>
          <span class="contact-method__text">
            <span class="contact-method__title">linkedin.com/in/darrel-danadyaksa-poli</span>
            <span class="contact-method__sub">Recruiters, referrals, quick intros</span>
          </span>
          <span class="contact-method__action contact-method__action--muted">→</span>
        </a>

        <a href="https://github.com/KronosDP" target="_blank" rel="noopener noreferrer" class="card contact-method">
          <span class="contact-method__icon"><Icon name="github" size={16} /></span>
          <span class="contact-method__text">
            <span class="contact-method__title">github.com/KronosDP</span>
            <span class="contact-method__sub">Code for the clickbait classifier and this site</span>
          </span>
          <span class="contact-method__action contact-method__action--muted">→</span>
        </a>
      </div>
    </div>

    <aside class="contact-sidebar">
      <div class="card contact-currently" data-reveal style="--reveal-delay: 100ms;">
        <p class="eyebrow">// currently</p>
        <div class="contact-currently__status">
          <span class="contact-currently__dot"></span>
          <span>Open to AI research, AI/ML engineering, and data science & analytics roles</span>
        </div>
        <div class="contact-currently__facts">
          <div><Icon name="map-pin" size={14} /><span>Jakarta, Indonesia, GMT+7</span></div>
          <div><Icon name="globe" size={14} /><span>Remote or relocation, both fine</span></div>
          <div><Icon name="clock" size={14} /><span>Usually replies within 24 hours</span></div>
          <div><Icon name="language" size={14} /><span>English, Bahasa Indonesia</span></div>
        </div>
      </div>
      <div class="card contact-before" data-reveal style="--reveal-delay: 170ms;">
        <p class="eyebrow">// before you write</p>
        <p class="contact-before__desc">The two-page CV covers dates, stacks and scope. The NVIDIA write-up covers how I think about a problem.</p>
        <div class="contact-before__links">
          <a href="/cv/">CV (PDF, 2 pages) →</a>
          <a href={`/projects/${research.data.slug}/`}>NVIDIA research write-up →</a>
        </div>
      </div>
    </aside>
  </section>
</BaseLayout>

<style>
  .contact {
    position: relative;
    padding: 64px var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 64px;
    align-items: start;
  }
  .contact__main {
    position: relative;
    z-index: 1;
  }
  .contact__title {
    font-family: var(--font-mono);
    font-size: 38px;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.18;
    margin: 0 0 20px;
    text-wrap: balance;
  }
  .contact__lede {
    max-width: 62ch;
    margin: 0 0 36px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 600px;
  }
  .contact-method {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: 18px;
    align-items: center;
    padding: 20px 22px;
    text-decoration: none;
    color: inherit;
    text-align: left;
    cursor: pointer;
    font: inherit;
  }
  .contact-method__icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-raised);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
  }
  .contact-method__text {
    display: block;
  }
  .contact-method__title {
    display: block;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
  }
  .contact-method__sub {
    display: block;
    margin-top: 4px;
    font-size: 13.5px;
    color: var(--color-muted);
  }
  .contact-method__action {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-accent);
  }
  .contact-method__action--muted {
    color: var(--color-muted);
  }

  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .contact-currently,
  .contact-before {
    padding: 24px;
  }
  .contact-currently__status {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-bottom: 16px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--color-text);
  }
  .contact-currently__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-success);
    margin-top: 6px;
    flex: 0 0 9px;
    animation: status-pulse 2.4s ease-in-out infinite;
  }
  @keyframes status-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-success) 45%, transparent);
    }
    50% {
      box-shadow: 0 0 0 5px transparent;
    }
  }
  .contact-currently__facts {
    display: flex;
    flex-direction: column;
    gap: 11px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .contact-currently__facts div {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
  }
  .contact-currently__facts :global(svg) {
    color: var(--color-accent);
    margin-top: 2px;
  }
  .contact-before__desc {
    margin: 0 0 16px;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--color-muted);
  }
  .contact-before__links {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .contact-before__links a {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-accent);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: 1fr;
      padding: 40px var(--gutter-mobile);
    }
  }
</style>

<script>
  const btn = document.getElementById('copy-email-btn');
  const label = document.getElementById('copy-email-label');
  btn?.addEventListener('click', async () => {
    const email = btn.getAttribute('data-email');
    if (!email || !label) return;
    try {
      await navigator.clipboard.writeText(email);
      const original = label.textContent;
      label.textContent = 'copied!';
      label.classList.remove('pop-feedback');
      void label.offsetWidth; // restart the animation if clicked again quickly
      label.classList.add('pop-feedback');
      setTimeout(() => {
        label.textContent = original;
      }, 1800);
    } catch {
      window.location.href = `mailto:${email}`;
    }
    // @ts-ignore
    window.gtag?.('event', 'contact_click');
  });
</script>
