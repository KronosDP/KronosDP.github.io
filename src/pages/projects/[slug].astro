---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const entries = await getCollection('research');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;

const allProjects = await getCollection('projects');
function findTitle(slug?: string) {
  return allProjects.find((p) => p.data.slug === slug)?.data.title;
}
const prevTitle = findTitle(data.prevProjectSlug);
const nextTitle = findTitle(data.nextProjectSlug);

const sections = [
  { id: 'benchmark', label: 'The benchmark' },
  { id: 'hard-negatives', label: 'Hard negatives' },
  { id: 'cuda-operator', label: 'The CUDA operator' },
  { id: 'on-results', label: 'On results' },
];
---

<BaseLayout title={data.title} description={data.summary}>
  <div class="container case-study">
    <div class="case-study__main">
      <a href="/projects/" class="case-study__back">← all projects</a>
      <div data-reveal>
        <span class="eyebrow case-study__eyebrow">// {data.org.toLowerCase()}</span>
        <h1 class="case-study__title">{data.question}</h1>
        <p class="case-study__summary">{data.summary}</p>
      </div>

      {
        data.image ? (
          <figure class="case-study__figure case-study__figure--image" data-reveal style="--reveal-delay: 90ms;">
            <img src={data.image} alt={data.figureCaption ?? data.title} />
            {data.figureCaption && <figcaption>{data.figureCaption}</figcaption>}
          </figure>
        ) : (
          <div class="figure-placeholder case-study__figure" data-reveal style="--reveal-delay: 90ms;">
            {data.figureCaption && <span>{data.figureCaption}</span>}
          </div>
        )
      }

      <h2 id="benchmark" class="case-study__h2">The benchmark</h2>
      <p class="case-study__p">{data.benchmarkIntro}</p>
      <div class="language-list">
        {
          data.languages.map((lang, i) => (
            <div class="language-list__item card" data-reveal style={`--reveal-delay: ${Math.min(i, 4) * 60}ms;`}>
              <span class="language-list__code">{lang.code}</span>
              <span class="language-list__desc">{lang.description}</span>
            </div>
          ))
        }
      </div>

      <h2 id="hard-negatives" class="case-study__h2">Hard negatives</h2>
      <p class="case-study__p">{data.hardNegativesIntro}</p>
      <div class="hard-negatives card" data-reveal>
        {
          data.hardNegativeExamples.map((ex) => (
            <div>
              <span class:list={['hard-negatives__verdict', `hard-negatives__verdict--${ex.verdict}`]}>{ex.verdict}</span>
               {ex.sequence} 
              <span class="hard-negatives__note">← {ex.note}</span>
            </div>
          ))
        }
      </div>

      <h2 id="cuda-operator" class="case-study__h2">The CUDA operator</h2>
      <p class="case-study__p">
        {data.cudaIntro.split('wkv_kernel.cu').map((chunk, i, arr) => (
          <>
            {chunk}
            {i < arr.length - 1 && <code class="inline-code">wkv_kernel.cu</code>}
          </>
        ))}
      </p>

      <div class="results-callout" id="on-results" data-reveal>
        <p class="eyebrow">// on results</p>
        <p class="results-callout__text">{data.resultsNote}</p>
      </div>
    </div>

    <aside class="case-study__sidebar">
      <div class="card case-study__glance" data-reveal>
        <p class="eyebrow">// at a glance</p>
        <div class="glance-fact"><span class="glance-fact__label">Role</span><span class="glance-fact__value">{data.role}</span></div>
        <div class="glance-fact"><span class="glance-fact__label">Duration</span><span class="glance-fact__value">{data.duration}</span></div>
        <div class="glance-fact"><span class="glance-fact__label">Models compared</span><span class="glance-fact__value">{data.modelsCompared.join(', ')}</span></div>
        <div class="glance-fact"><span class="glance-fact__label">Stack</span><span class="glance-fact__value">{data.stack.join(', ')}</span></div>
      </div>
      <div class="card case-study__toc" data-reveal style="--reveal-delay: 80ms;">
        <p class="eyebrow">// on this page</p>
        <div class="toc-links">
          {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
        </div>
      </div>
      <a href="/contact/" class="card card--emphasis case-study__cta" data-reveal style="--reveal-delay: 160ms;">
        <p class="case-study__cta-title">Want the detail?</p>
        <p class="case-study__cta-desc">Ask me about the failure modes on L2 and L3: that is where it got interesting.</p>
        <span class="btn btn--primary">Get in touch <Icon name="arrow-right" size={14} /></span>
      </a>
    </aside>
  </div>

  {
    (prevTitle || nextTitle) && (
      <div class="case-study__pager">
        <div class="container case-study__pager-inner">
          {prevTitle ? (
            <a href="/projects/" class="case-study__pager-link">
              <span class="case-study__pager-label">← previous</span>
              <span class="case-study__pager-title">{prevTitle}</span>
            </a>
          ) : <span />}
          {nextTitle ? (
            <a href="/projects/" class="case-study__pager-link case-study__pager-link--next">
              <span class="case-study__pager-label">next →</span>
              <span class="case-study__pager-title">{nextTitle}</span>
            </a>
          ) : <span />}
        </div>
      </div>
    )
  }
</BaseLayout>

<style>
  .case-study {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 56px;
    padding: 48px var(--gutter);
  }
  .case-study__back {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent);
    text-decoration: none;
  }
  .case-study__eyebrow {
    margin: 24px 0 14px;
  }
  .case-study__title {
    font-family: var(--font-mono);
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin: 0 0 20px;
    text-wrap: balance;
  }
  .case-study__summary {
    max-width: 70ch;
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0 0 32px;
  }
  .case-study__figure {
    height: 280px;
    border-radius: var(--radius-card);
    padding: 16px;
    margin-bottom: 12px;
  }
  .case-study__figure--image {
    margin: 0 0 12px;
    padding: 0;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }
  .case-study__figure--image img {
    width: 100%;
    height: 240px;
    object-fit: contain;
    background: var(--color-canvas);
  }
  .case-study__figure--image figcaption {
    padding: 10px 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-muted);
    border-top: 1px solid var(--color-border);
  }
  .case-study__h2 {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 40px 0 14px;
    scroll-margin-top: 90px;
  }
  .case-study__p {
    max-width: 70ch;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0 0 20px;
  }
  .language-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 70ch;
    margin-bottom: 32px;
  }
  .language-list__item {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 16px;
    border-radius: 8px;
    padding: 14px 16px;
  }
  .language-list__code {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-accent);
  }
  .language-list__desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .hard-negatives {
    border-radius: 8px;
    padding: 16px 18px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.9;
    margin-bottom: 32px;
    max-width: 70ch;
  }
  .hard-negatives__verdict--accept {
    color: var(--color-success);
  }
  .hard-negatives__verdict--reject {
    color: var(--color-reject);
  }
  .hard-negatives__note {
    color: var(--color-muted);
  }
  .inline-code {
    font-family: var(--font-mono);
    font-size: 14px;
    background: var(--color-raised);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 1px 6px;
    color: var(--color-badge-text);
  }
  .results-callout {
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-card);
    padding: 24px;
    max-width: 70ch;
  }
  .results-callout__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .case-study__sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .case-study__glance,
  .case-study__toc {
    padding: 20px;
  }
  .glance-fact {
    display: flex;
    flex-direction: column;
    font-size: 13px;
    line-height: 1.5;
    margin-bottom: 14px;
  }
  .glance-fact:last-child {
    margin-bottom: 0;
  }
  .glance-fact__label {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin-bottom: 2px;
  }
  .glance-fact__value {
    color: var(--color-text);
  }
  .toc-links {
    display: flex;
    flex-direction: column;
    gap: 9px;
    font-size: 13px;
  }
  .toc-links a {
    color: var(--color-muted);
    text-decoration: none;
    transition:
      color var(--duration-base) var(--ease-out),
      padding-left var(--duration-base) var(--ease-out);
  }
  .toc-links a:hover,
  .toc-links a.is-active {
    color: var(--color-text);
    padding-left: 4px;
  }
  .case-study__cta {
    display: block;
    padding: 20px;
    text-decoration: none;
  }
  .case-study__cta-title {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text);
  }
  .case-study__cta-desc {
    margin: 0 0 14px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .case-study__pager {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .case-study__pager-inner {
    padding: 28px var(--gutter);
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }
  .case-study__pager-link {
    text-decoration: none;
    display: inline-block;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .case-study__pager-link:hover {
    transform: translateX(-3px);
  }
  .case-study__pager-link--next:hover {
    transform: translateX(3px);
  }
  .case-study__pager-link--next {
    text-align: right;
  }
  .case-study__pager-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .case-study__pager-title {
    display: block;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-text);
  }

  @media (max-width: 900px) {
    .case-study {
      grid-template-columns: 1fr;
      padding: 32px var(--gutter-mobile);
    }
  }
</style>

<script>
  // Simple scrollspy for the "on this page" TOC.
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc-links a');
  const targets = Array.from(links)
    .map((l) => document.querySelector(l.getAttribute('href') ?? ''))
    .filter((el): el is Element => el !== null);

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const id = entry.target.id;
        const link = document.querySelector(`.toc-links a[href="#${id}"]`);
        if (entry.isIntersecting) {
          links.forEach((l) => l.classList.remove('is-active'));
          link?.classList.add('is-active');
        }
      });
    },
    { rootMargin: '-20% 0px -70% 0px' },
  );
  targets.forEach((t) => observer.observe(t));
</script>
