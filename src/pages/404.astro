---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <section class="container error-page">
    <span class="eyebrow">404</span>
    <h1 class="error-page__title">This page <span class="error-page__brace">/</span> does not exist</h1>
    <p class="error-page__lede">The link may be out of date, or the page may have moved while the site was rebuilt. Nothing is broken on your end.</p>
    <div class="error-page__ctas">
      <a href="/" class="btn btn--primary">Back to home</a>
      <a href="/projects/" class="btn btn--ghost">Project showcase</a>
    </div>
    <div class="error-page__links">
      <p class="eyebrow">try one of these</p>
      <ul>
        <li><a href="/cv/">Curriculum vitae</a></li>
        <li><a href="/projects/">Project portfolio</a></li>
        <li><a href="/teaching/">Teaching material</a></li>
        <li><a href="/talks/">Talks & training</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    padding: 96px var(--gutter) 96px;
    max-width: 640px;
  }
  .error-page__title {
    font-family: var(--font-mono);
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
  }
  .error-page__brace {
    color: var(--color-accent);
  }
  .error-page__lede {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0 0 32px;
  }
  .error-page__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }
  .error-page__links ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .error-page__links a {
    font-size: 14px;
    text-decoration: none;
  }
</style>
